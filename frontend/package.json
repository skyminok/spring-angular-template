{
    "name": "ng-template",
    "type": "module",
    "version": "1.0.0",
    "scripts": {
        "start-local": "ng serve --configuration=hmr --proxy-config proxy-local.conf.json",
        "build": "ng build",
        "buildDev": "ng build --configuration=development",
        "test": "ng test --browsers=ChromeHeadless --watch=false",
        "test-watch": "ng test --browsers=ChromeHeadless --watch=true",
        "lint": "ng lint --max-warnings 0 --fix",
        "e2e": "ng e2e",
        "watch": "ng build --watch --configuration development"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^22.2.1",
        "@angular/common": "^22.2.1",
        "@angular/compiler": "^22.2.1",
        "@angular/core": "^22.2.1",
        "@angular/forms": "^22.2.1",
        "@angular/platform-browser": "^22.2.1",
        "@angular/platform-browser-dynamic": "^22.2.1",
        "@angular/router": "^22.2.1",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1",
        "zone.js": "~0.16.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^22.2.1",
        "@angular/cli": "~22.2.0",
        "@angular/compiler-cli": "^22.2.1",
        "@types/jasmine": "~5.1.4",
        "jasmine-core": "~5.1.2",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "typescript": "~6.0.0",
        "eslint": "^9.29.0",
        "@angular-eslint/builder": "22.5.0",
        "@angular-eslint/eslint-plugin": "22.5.0",
        "@angular-eslint/eslint-plugin-template": "22.5.0",
        "@angular-eslint/schematics": "22.5.0",
        "@angular-eslint/template-parser": "22.5.0",
        "@typescript-eslint/eslint-plugin": "8.71.0",
        "@typescript-eslint/parser": "8.71.0",
        "typescript-eslint": "8.71.0"
    }
}
